---
/**
 * The daylight ↔ afterglow switch. Shows the theme you'd switch *to* (moon by day, sun by
 * night — drawn by .iz-theme-toggle__glyph in site.css), persists the choice, and reports
 * state through aria-pressed ("afterglow is on"). The name stays fixed so the pressed state is
 * the only thing that changes; a name that also flipped ("Switch to…") would announce the state
 * twice. The glyph is CSS content with empty alt text on an inner span (the button's own
 * pseudo-elements belong to the burst), so the button carries no visible text that its name
 * would have to include. ThemeBoot.astro must have stamped data-theme already.
 */
---

<button
  type="button"
  class="dz-btn dz-btn--ghost dz-btn--sm iz-theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Afterglow theme"
>
  <span class="iz-theme-toggle__glyph" aria-hidden="true"></span>
</button>

<script>
  import { applyTheme, storeTheme, isTheme, type Theme } from '../scripts/theme';

  const root = document.documentElement;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));

  const sync = () => {
    const dark = root.dataset.theme === 'afterglow';
    for (const btn of buttons) btn.setAttribute('aria-pressed', String(dark));
  };
  sync();

  // data-theme can change without a click — ThemeBoot re-stamps it when the OS preference flips
  // and no choice is stored — so the button's reported state follows the attribute, not clicks.
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const current = isTheme(root.dataset.theme) ? root.dataset.theme : 'daylight';
      const next: Theme = current === 'afterglow' ? 'daylight' : 'afterglow';
      applyTheme(next);
      storeTheme(next);
    });
  }
</script>
