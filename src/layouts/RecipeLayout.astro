---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { inlineMarkdown } from '../lib/markdown';
import { toGrams, formatGrams, ingredientLabel, withDetail, type Densities } from '../lib/units';
import { buildIngredientIndex, linkIngredientsInHtml } from '../lib/ingredients';
import densityData from '../data/densities.json';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, description, category, prepTime, cookTime, servings, tools, ingredients, steps, notes } =
  recipe.data;

const hasMeta = prepTime !== undefined || cookTime !== undefined || servings !== undefined;

// Precompute each ingredient's US label and, where the ingredient's grams-per-cup ratio is
// known (or the unit is already a weight), its grams label. Items that can't be converted
// (no/unknown unit or density) have grams === null and always show the US text.
const densities = densityData as Densities;
const ingredientGroups = ingredients.map((group) => ({
  group: group.group,
  items: group.items.map((item) => {
    const us = ingredientLabel(item);
    const grams = toGrams(item.qty, item.unit, item.name, densities);
    return {
      us,
      grams: grams === null ? null : withDetail(`${formatGrams(grams)} ${item.name}`, item.detail),
    };
  }),
}));
const anyConvertible = ingredientGroups.some((group) => group.items.some((item) => item.grams !== null));

// Index the recipe's ingredients so mentions in the step prose can be linked to their
// measurement. `idState` threads a single counter through every step so each popover
// gets a page-unique id for its aria-describedby.
const ingredientIndex = buildIngredientIndex(ingredients, (item) => {
  const grams = toGrams(item.qty, item.unit, item.name, densities);
  return grams === null ? null : formatGrams(grams);
});
const popoverIds = { n: 0 };
---

<BaseLayout title={title} description={description}>
  <article>
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">{title}</h1>

    <p class="mt-2 text-sm capitalize text-neutral-500 dark:text-neutral-500">{category}</p>

    <a
      href={`/upload?edit=${recipe.id}`}
      class="auth-only mt-1 inline-flex items-center gap-1 text-xs text-neutral-400 hover:text-accent-600 hover:underline dark:text-neutral-500 dark:hover:text-accent-100"
    >
      ✎ Edit recipe
    </a>

    {hasMeta && (
      <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 rounded-lg bg-neutral-50 px-4 py-3 text-sm dark:bg-neutral-900">
        {prepTime !== undefined && (
          <div class="flex gap-1.5">
            <dt class="text-neutral-500 dark:text-neutral-500">Prep</dt>
            <dd class="font-medium text-neutral-800 dark:text-neutral-200">{prepTime} min</dd>
          </div>
        )}
        {cookTime !== undefined && (
          <div class="flex gap-1.5">
            <dt class="text-neutral-500 dark:text-neutral-500">Cook</dt>
            <dd class="font-medium text-neutral-800 dark:text-neutral-200">{cookTime} min</dd>
          </div>
        )}
        {servings !== undefined && (
          <div class="flex gap-1.5">
            <dt class="text-neutral-500 dark:text-neutral-500">Servings</dt>
            <dd class="font-medium text-neutral-800 dark:text-neutral-200">{servings}</dd>
          </div>
        )}
      </dl>
    )}

    {tools.length > 0 && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Tools</h2>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {tools.map((tool) => (
            <span class="rounded-md border border-neutral-200 px-2 py-1 text-xs text-neutral-600 dark:border-neutral-800 dark:text-neutral-400">
              {tool}
            </span>
          ))}
        </div>
      </section>
    )}

    <section class="mt-8">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Ingredients</h2>
        {anyConvertible && (
          <div
            id="units-toggle"
            class="inline-flex rounded-lg border border-neutral-200 p-0.5 text-xs font-medium dark:border-neutral-800"
            role="group"
            aria-label="Ingredient units"
          >
            <button type="button" data-units-btn="us" class="rounded-md px-2.5 py-1 text-neutral-500 dark:text-neutral-400">US</button>
            <button type="button" data-units-btn="grams" class="rounded-md px-2.5 py-1 text-neutral-500 dark:text-neutral-400">Grams</button>
          </div>
        )}
      </div>
      <div id="ingredients-list" class="mt-3 space-y-4" data-units="us">
        {ingredientGroups.map((group) => (
          <div>
            {group.group && <h3 class="mb-1.5 font-medium text-neutral-800 dark:text-neutral-200">{group.group}</h3>}
            <ul class="space-y-1">
              {group.items.map((item) => (
                <li class:list={['ing-item flex gap-2 text-neutral-700 dark:text-neutral-300', { 'is-convertible': item.grams !== null }]}>
                  <span class="text-accent-600 dark:text-accent-100" aria-hidden="true">&bull;</span>
                  <span class="ing-us">{item.us}</span>
                  {item.grams !== null && <span class="ing-grams">{item.grams}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Steps</h2>
      <div class="mt-3 space-y-4">
        {steps.map((group) => (
          <div>
            {group.group && <h3 class="mb-1.5 font-medium text-neutral-800 dark:text-neutral-200">{group.group}</h3>}
            <ol class="space-y-3">
              {group.items.map((step, i) => (
                <li class="flex gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-50 text-xs font-medium text-accent-700 dark:bg-neutral-800 dark:text-accent-100">
                    {i + 1}
                  </span>
                  <span class="text-neutral-700 dark:text-neutral-300" set:html={linkIngredientsInHtml(inlineMarkdown(step), ingredientIndex, popoverIds)} />
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    {notes.length > 0 && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Notes</h2>
        <ul class="mt-3 space-y-1.5">
          {notes.map((note) => (
            <li class="text-sm text-neutral-600 dark:text-neutral-400">{note}</li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* US mode: hide the grams labels. Grams mode: hide the US label only on items that have a
     grams equivalent — non-convertible items keep showing their US text in both modes. */
  #ingredients-list[data-units='us'] .ing-grams {
    display: none;
  }
  #ingredients-list[data-units='grams'] .is-convertible .ing-us {
    display: none;
  }
</style>

<script>
  import { applyAuthState } from '../scripts/recipe-session';
  import { initIngredientPopovers } from '../scripts/ingredient-popover';

  // Reveal the edit link only when signed in. OAuth never returns to a detail page, so there's no
  // hash to ingest here — just reflect the stored session onto <html data-auth> and let CSS gate.
  applyAuthState();

  // Tap-toggle + dismissal for the ingredient-measurement popovers in the steps (hover/focus
  // are pure CSS; this only adds touch and Escape/outside-click behavior).
  initIngredientPopovers();

  // Ingredient unit toggle (US ↔ Grams). The choice is stored so it carries across recipes.
  const UNITS_KEY = 'izzy-recipe-units';
  const list = document.getElementById('ingredients-list');
  const toggle = document.getElementById('units-toggle');
  if (list && toggle) {
    const buttons = toggle.querySelectorAll<HTMLButtonElement>('[data-units-btn]');
    const activeCls = ['bg-accent-50', 'text-accent-700', 'dark:bg-neutral-800', 'dark:text-accent-100'];

    const apply = (units: string) => {
      const mode = units === 'grams' ? 'grams' : 'us';
      list.dataset.units = mode;
      // Also reflect the mode on <html> so the step popovers (outside #ingredients-list)
      // switch US ↔ grams with the same toggle.
      document.documentElement.dataset.units = mode;
      for (const btn of buttons) {
        const on = btn.dataset.unitsBtn === mode;
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.toggle('text-neutral-500', !on);
        btn.classList.toggle('dark:text-neutral-400', !on);
        activeCls.forEach((c) => btn.classList.toggle(c, on));
      }
    };

    let stored: string | null = null;
    try { stored = localStorage.getItem(UNITS_KEY); } catch { /* private mode — just default */ }
    apply(stored ?? 'us');

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.unitsBtn ?? 'us';
        apply(mode);
        try { localStorage.setItem(UNITS_KEY, mode); } catch { /* non-fatal */ }
      });
    }
  }
</script>
