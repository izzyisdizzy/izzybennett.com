---
import { getEntry } from 'astro:content';
import { parseMenu } from '@izzy/cafe-menu';
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';

// The menu board. Rendered from the same parseMenu output as /izzys-cafe.json, /order and the
// dizzyos sign, so the page can never disagree with them — the markdown stays the one source.
const page = await getEntry('pages', 'izzys-cafe');
if (!page) throw new Error('Missing "izzys-cafe" entry in the pages collection');
const sections = parseMenu(page.body ?? '');

// Same `||` + DEV fallback as /order: an unset Actions var arrives as "" and must fall through.
const ORDER_API = import.meta.env.PUBLIC_ORDER_API || (import.meta.env.DEV ? 'http://localhost:8000' : '');

const glyph: Record<string, string> = { Drinks: '☕', Milks: '🥛', Syrups: '🍯', Food: '🍰' };
---

<BaseLayout title={page.data.title} description="The menu at Izzy's home cafe.">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="display-xl" data-dz-bounce="once">{page.data.title}</h1>
      <p class="body-l mt-2 text-ink-muted">Pick a drink, tell me how you like it, and I'll make it.</p>
    </div>
    <!-- Filled in from the order server's public /status; stays hidden if it can't be reached. -->
    <p data-kitchen-tag hidden></p>
  </div>

  <Window title="menu.txt" class="mt-8" bodyClass="p-6 sm:px-8 sm:pb-8 sm:pt-7" aria-labelledby="menu-heading">
    <h2 id="menu-heading" class="label"><span class="dz-sparkle" aria-hidden="true">✦</span> Menu</h2>
    <div class="mt-4 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {sections.map((section) => (
        <div>
          <h3 class="h2">
            <span aria-hidden="true">{glyph[section.heading] ?? '✦'}</span> {section.heading}
          </h3>
          <ul class="mt-2">
            {section.items.map((item) => (
              <li class="body-l border-b border-hairline py-1 last:border-b-0">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Window>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a href="/order/" class="dz-btn dz-btn--lg">Order a drink →</a>
    <p class="caption">Food is on the menu board only — just ask.</p>
  </div>

  <div class="dz-marquee dz-marquee--pink mt-10" data-dz-marquee role="marquee" aria-label="Cafe ticker">
    <div class="dz-marquee__track">
      <span>☕ fresh every order</span>
      <span>✦ oat or whole, hot or iced</span>
      <span>🍯 house syrups made from the recipes on this site</span>
      <span>✦ tip in compliments</span>
    </div>
  </div>

  <span hidden data-order-api={ORDER_API}></span>
</BaseLayout>

<script>
  import { fetchKitchenOpen } from '../scripts/order-status';

  const tag = document.querySelector<HTMLElement>('[data-kitchen-tag]');
  const api = document.querySelector<HTMLElement>('[data-order-api]')?.dataset.orderApi ?? '';

  // Open/closed always carries its word, never colour alone (the leaf/cherry token notes).
  fetchKitchenOpen(api).then((open) => {
    if (!tag || open === null) return;
    tag.className = `dz-tag ${open ? 'dz-tag--ready' : 'dz-tag--stopped'}`;
    tag.textContent = open ? '● Kitchen open' : '● Kitchen closed';
    tag.hidden = false;
  });
</script>
