---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectWindow from '../components/ProjectWindow.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Things Izzy Bennett has built.">
  <h1 class="display-xl" data-dz-bounce="hover">Projects</h1>
  <p class="body-l mt-2 text-ink-muted">Things I've built.</p>

  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    {projects.map((project) => <ProjectWindow project={project} />)}
  </div>
</BaseLayout>
