---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedDemo from '../../components/FeedDemo.astro';
import Window from '../../components/Window.astro';
import { FEEDS } from '../../lib/feeds';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, others: projects.filter((other) => other.id !== project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  others: CollectionEntry<'projects'>[];
}

const { project, others } = Astro.props;
const { Content } = await render(project);
const { title, tagline, repo, links, demo } = project.data;
const repoSlug = repo?.replace(/^https:\/\/github\.com\//, '');
const feedSrc = demo && FEEDS[demo].src;
// The live-feed row already links the demo's feed, so a link to the same URL isn't repeated.
const factLinks = links.filter((link) => link.href !== feedSrc);
const hasFacts = Boolean(repo || factLinks.length > 0 || feedSrc);
const kind = (other: CollectionEntry<'projects'>) => (other.data.repo ? 'repo' : other.data.demo ? 'feed' : '');
---

<BaseLayout title={title} description={tagline}>
  <p><a href="/projects/" class="dz-link body-s">← Projects</a></p>

  <!-- As on the canvas board: content beside a 420px aside at the board's width, narrowing toward
       lg so the prose keeps its measure. Below lg the aside follows the content, its two windows
       side by side from sm, stacked on phones. -->
  <div class="mt-4 lg:grid lg:grid-cols-[minmax(0,1fr)_clamp(18rem,36.5%,420px)] lg:items-start lg:gap-12">
    <div class="min-w-0">
      <h1 class="display-l" data-dz-bounce="once">{title}</h1>
      <p class="mt-3"><span class="dz-tag dz-tag--aqua">{tagline}</span></p>

      <div class="iz-prose mt-8">
        <Content />
      </div>

      {demo && (
        <div class="mt-8">
          <FeedDemo kind={demo} />
        </div>
      )}
    </div>

    {(hasFacts || others.length > 0) && (
      <aside class="mt-12 grid items-start gap-6 sm:grid-cols-2 lg:mt-0 lg:grid-cols-1" aria-label={`About ${title}`}>
        <!-- Facts come only from existing frontmatter; a row renders only when it has a value. The
             repo and links rows carry every link the page has, so there's no separate button row. -->
        {hasFacts && (
          <Window title="facts.txt" bodyClass="p-6">
            <h2 class="h3">Facts</h2>
            <dl class="mt-3">
              {repo && (
                <div class="iz-fact">
                  <dt class="body-s text-ink-muted">Repo</dt>
                  <dd class="mono"><a href={repo} class="dz-link" target="_blank" rel="noopener noreferrer">{repoSlug}</a></dd>
                </div>
              )}
              {factLinks.length > 0 && (
                <div class="iz-fact">
                  <dt class="body-s text-ink-muted">Links</dt>
                  <dd class="mono flex flex-wrap justify-end gap-x-3">
                    {factLinks.map((link) => <a href={link.href} class="dz-link">{link.label}</a>)}
                  </dd>
                </div>
              )}
              {feedSrc && (
                <div class="iz-fact">
                  <dt class="body-s text-ink-muted">Live feed</dt>
                  <dd class="mono"><a href={feedSrc} class="dz-link">{feedSrc}</a></dd>
                </div>
              )}
            </dl>
          </Window>
        )}

        {others.length > 0 && (
          <Window title="more-projects.txt" bodyClass="px-6 pb-6 pt-5">
            <h2 class="h3">More projects</h2>
            <div class="mt-3 flex flex-col">
              {others.map((other) => (
                <a href={`/projects/${other.id}/`} class="dz-row iz-row-tight">
                  <span class="dz-row__title">{other.data.title}</span>
                  {kind(other) && <span class="dz-row__meta">{kind(other)}</span>}
                </a>
              ))}
            </div>
          </Window>
        )}
      </aside>
    )}
  </div>
</BaseLayout>
