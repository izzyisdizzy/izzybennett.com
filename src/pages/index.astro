---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import me from '../assets/me.jpeg';

// Base URL of the Pi order server, for the live "kitchen open/closed" word in the ticker. Same
// `||` + DEV fallback as /order: an unset Actions var arrives as "" and must fall through too.
const ORDER_API = import.meta.env.PUBLIC_ORDER_API || (import.meta.env.DEV ? 'http://localhost:8000' : '');

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

// Three recipes for the ticker. Recipes carry no date, so "newest" isn't knowable; instead the
// pick rotates with the build day, so every deploy (menu edits, new recipes) reshuffles it.
const day = Math.floor(Date.now() / 86_400_000);
const picks = [0, 1, 2]
  .map((i) => recipes[(day * 3 + i * 7) % recipes.length])
  .filter((recipe, i, all) => recipe && all.indexOf(recipe) === i);
---

<BaseLayout title="Home">
  <!-- The hero is two sibling windows, never one nested in the other: welcome.txt holds the
       text, me.jpeg sits beside it (above it on phones, as before). -->
  <div class="flex flex-col-reverse gap-6 sm:flex-row sm:items-center">
    <Window title="welcome.txt" class="min-w-0 flex-1" bodyClass="p-6 sm:px-10 sm:py-10">
      <p class="label"><span class="dz-sparkle" aria-hidden="true">✦</span> hi, I'm</p>
      <!-- The page's one bouncing headline (see the display-xxl token note). -->
      <h1 class="display-xxl mt-2 iz-hero-name" data-dz-bounce="once">Izzy Bennett</h1>
      <p class="body-l mt-4 text-ink-muted">Welcome to my personal website!</p>
      <p class="mt-4 max-w-[45rem]">
        This website is a personal project of mine. I mostly use it to store my recipes and
        share them with others. I can be reached at <a class="dz-link" href="mailto:me@izzybennett.com">me@izzybennett.com</a>.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/recipes/" class="dz-btn">Recipes</a>
        <a href="/order/" class="dz-btn dz-btn--orange">Order a drink ☕</a>
        <a href="/projects/" class="dz-btn dz-btn--ghost">Projects</a>
      </div>
    </Window>

    <figure class="dz-window w-40 shrink-0 self-center sm:w-48 lg:w-64">
      <div class="dz-window__bar">
        <span class="dz-window__lights" aria-hidden="true">
          <span class="dz-window__light"></span><span class="dz-window__light"></span><span class="dz-window__light"></span>
        </span>
        <span class="dz-window__title">me.jpeg</span>
      </div>
      <!-- aspect-square + border-b-0 are utilities, so they override the media class's 4:3 and
           its bottom rule (the image is the window's last child). -->
      <Image
        src={me}
        alt="Izzy, on a canal in Amsterdam"
        width={256}
        height={256}
        widths={[160, 192, 256, 320, 384, 512, 576, 768]}
        sizes="(min-width: 1024px) 256px, (min-width: 640px) 192px, 160px"
        class="dz-window__media aspect-square border-b-0"
      />
    </figure>
  </div>

  <!-- Ticker. Plain text only: bundle.js clones the track (aria-hidden) for the seamless loop,
       and a link in there would come back as a second, hidden tab stop. -->
  <div class="dz-marquee mt-8" data-dz-marquee data-order-api={ORDER_API} role="marquee" aria-label="Site ticker">
    <div class="dz-marquee__track">
      <span>✦ {recipes.length} recipes and counting</span>
      {picks.map((recipe) => <span>🍳 try the {recipe.data.title}</span>)}
      <span>☕ Izzy's Cafe is <span data-kitchen-status>taking orders</span></span>
      <span>✦ built with Astro + Dizzy</span>
    </div>
  </div>
</BaseLayout>

<script>
  import { fetchKitchenOpen } from '../scripts/order-status';

  // Swap the ticker's kitchen word for the live state. Updates every copy — the marquee clone
  // included — and leaves the build-time text alone when the Pi can't be reached.
  const marquee = document.querySelector<HTMLElement>('[data-dz-marquee]');
  if (marquee) {
    fetchKitchenOpen(marquee.dataset.orderApi ?? '').then((open) => {
      if (open === null) return;
      for (const el of marquee.querySelectorAll('[data-kitchen-status]')) {
        el.textContent = open ? 'open for orders' : 'closed right now 😴';
      }
    });
  }
</script>
